# Build output - everything here is regenerated by the Monkey C compiler
# on every build (confirmed from your actual project's real bin/ folder:
# .prg, .prg.debug.xml, .mir files, generated resource cache under
# bin/gen/ and bin/internal-mir/, fit-contributions/settings JSON). None
# of this is source - never commit it.
bin/

# VS Code editor state - safe to keep .vscode/launch.json or settings.json
# if you want shared debug configs, but workspace-specific state usually
# isn't something to commit. Remove this line if you specifically want
# your launch.json tracked for convenience.
.vscode/

# OS cruft
.DS_Store
Thumbs.db
